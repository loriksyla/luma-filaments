{
  "name": "luma-filaments",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "npm run check:node22",
    "check:node22": "node -e \"const major = Number(process.versions.node.split('.')[0]); if (major !== 22) { console.error('Node 22.x is required. Current: ' + process.versions.node); process.exit(1); }\"",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-amplify/storage": "^6.13.1",
    "@aws-sdk/client-ses": "^3.981.0",
    "aws-amplify": "^6.16.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.20.0",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk-lib": "^2.234.1",
    "constructs": "^10.4.5",
    "esbuild": "^0.27.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
